# ============================================================
# AI Integration Engineer Platform — Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=AI Integration Engineer Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://aiep_user:aiep_secret_2024@localhost:5432/aiep_db
# For SQLite fallback (development):
# DATABASE_URL=sqlite+aiosqlite:///./aiep.db

# --- Vector Database (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=aiep_knowledge

# --- AI Provider ---
# Options: openai, claude, ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Claude (optional)
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Ollama (optional, local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Storage ---
# Options: local, s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# --- Ingestion ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_UPLOAD_SIZE_MB=50

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/aiep.log
